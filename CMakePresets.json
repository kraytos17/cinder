{
   "version":6,
   "configurePresets":[
      {
         "name":"debug",
         "displayName":"Debug",
         "description":"Debug build with Ninja (GCC)",
         "generator":"Ninja",
         "binaryDir":"${sourceDir}/build/debug",
         "cacheVariables":{
            "CMAKE_BUILD_TYPE":"Debug"
         }
      },
      {
         "name":"debug-clang",
         "displayName":"Debug (Clang)",
         "description":"Debug build with Clang",
         "generator":"Ninja",
         "binaryDir":"${sourceDir}/build/debug-clang",
         "cacheVariables":{
            "CMAKE_BUILD_TYPE":"Debug",
            "CMAKE_CXX_COMPILER":"clang++",
            "CMAKE_C_COMPILER":"clang"
         }
      },
      {
         "name":"release",
         "displayName":"Release",
         "description":"Optimized release build with LTO (GCC)",
         "generator":"Ninja",
         "binaryDir":"${sourceDir}/build/release",
         "cacheVariables":{
            "CMAKE_BUILD_TYPE":"Release",
            "CINDER_ENABLE_LTO":"ON"
         }
      },
      {
         "name":"sanitized",
         "displayName":"Sanitized",
         "description":"Debug build with ASan+UBSan (GCC)",
         "generator":"Ninja",
         "binaryDir":"${sourceDir}/build/sanitized",
         "cacheVariables":{
            "CMAKE_BUILD_TYPE":"Debug",
            "CINDER_SANITIZE":"ON"
         }
      },
      {
         "name":"ci",
         "displayName":"CI",
         "description":"CI build with clang-tidy (Clang, no ASan — use ci-gcc for sanitizers)",
         "generator":"Ninja",
          "binaryDir":"${sourceDir}/build/ci",
          "cacheVariables":{
             "CMAKE_BUILD_TYPE":"RelWithDebInfo",
             "CMAKE_CXX_COMPILER":"clang++",
             "CMAKE_C_COMPILER":"clang",
             "CINDER_ENABLE_CLANG_TIDY":"ON"
          }
       },
       {
         "name":"ci-gcc",
         "displayName":"CI (GCC)",
         "description":"CI build with GCC, sanitizers, no clang-tidy",
         "generator":"Ninja",
          "binaryDir":"${sourceDir}/build/ci-gcc",
          "cacheVariables":{
             "CMAKE_BUILD_TYPE":"RelWithDebInfo",
             "CINDER_SANITIZE":"ON"
          }
       },
      {
         "name":"fast",
         "displayName":"Fast (unity + lld)",
         "description":"Debug build with unity/jumbo merging and lld (GCC)",
         "generator":"Ninja",
         "binaryDir":"${sourceDir}/build/fast",
         "cacheVariables":{
            "CMAKE_BUILD_TYPE":"Debug",
            "CINDER_UNITY_BUILD":"ON"
         }
      }
   ],
   "buildPresets":[
      {
         "name":"debug",
         "configurePreset":"debug"
      },
      {
         "name":"debug-clang",
         "configurePreset":"debug-clang"
      },
      {
         "name":"release",
         "configurePreset":"release"
      },
      {
         "name":"sanitized",
         "configurePreset":"sanitized"
      },
      {
         "name":"ci",
         "configurePreset":"ci"
      },
      {
         "name":"ci-gcc",
         "configurePreset":"ci-gcc"
      },
      {
         "name":"fast",
         "configurePreset":"fast"
      }
   ],
   "testPresets":[
      {
         "name":"debug",
         "configurePreset":"debug"
      },
      {
         "name":"ci",
         "configurePreset":"ci"
      },
      {
         "name":"ci-gcc",
         "configurePreset":"ci-gcc"
      }
   ]
}
