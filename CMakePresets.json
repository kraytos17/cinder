{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CINDER_ENABLE_CRYPTO": "ON",
        "CMAKE_COLOR_DIAGNOSTICS": "ON"
      }
    },
    {
      "name": "gcc-debug-base",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "${sourceDir}/toolchains/gcc16.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CINDER_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "clang-debug-base",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "${sourceDir}/toolchains/clang22.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CINDER_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "gcc-release-base",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "${sourceDir}/toolchains/gcc16.cmake",
      "cacheVariables": {
        "CINDER_LINK_JOBS": "2",
        "CMAKE_BUILD_TYPE": "Release",
        "CINDER_ENABLE_LTO": "ON",
        "CINDER_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "clang-release-base",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "${sourceDir}/toolchains/clang22.cmake",
      "cacheVariables": {
        "CINDER_LINK_JOBS": "2",
        "CMAKE_BUILD_TYPE": "Release",
        "CINDER_ENABLE_LTO": "ON",
        "CINDER_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "debug",
      "inherits": "gcc-debug-base",
      "displayName": "Debug",
      "description": "Debug build with Ninja (GCC)"
    },
    {
      "name": "debug-tls",
      "inherits": "gcc-debug-base",
      "displayName": "Debug + TLS",
      "description": "Debug build with TLS/SSL enabled",
      "cacheVariables": {
        "CINDER_ENABLE_TLS": "ON"
      }
    },
    {
      "name": "debug-tls-clang",
      "inherits": "clang-debug-base",
      "displayName": "Debug + TLS (Clang)",
      "description": "Clang debug build with TLS/SSL enabled",
      "cacheVariables": {
        "CINDER_ENABLE_TLS": "ON"
      }
    },
    {
      "name": "debug-clang",
      "inherits": "clang-debug-base",
      "displayName": "Debug (Clang)",
      "description": "Debug build with Ninja and Clang"
    },
    {
      "name": "release",
      "inherits": "gcc-release-base",
      "displayName": "Release",
      "description": "Optimized production release with LTO (GCC); benchmarks are opt-in"
    },
    {
      "name": "release-bench",
      "inherits": "gcc-release-base",
      "displayName": "Release + benchmarks",
      "description": "Optimized GCC release build with benchmark targets enabled",
      "cacheVariables": {
        "CINDER_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "pgo-generate",
      "inherits": "gcc-release-base",
      "displayName": "PGO instrumented (GCC)",
      "description": "Release+LTO build writing .gcda into build/pgo-data; train with the throughput bench, then switch to pgo-use (same build dir so profile paths match)",
      "binaryDir": "${sourceDir}/build/pgo",
      "cacheVariables": {
        "CINDER_BUILD_BENCHMARKS": "ON",
        "CINDER_PGO": "Generate",
        "CINDER_PGO_DIR": "${sourceDir}/build/pgo-data"
      }
    },
    {
      "name": "pgo-use",
      "inherits": "gcc-release-base",
      "displayName": "PGO optimized (GCC)",
      "description": "Release+LTO build consuming build/pgo-data profiles (same build dir as pgo-generate)",
      "binaryDir": "${sourceDir}/build/pgo",
      "cacheVariables": {
        "CINDER_BUILD_BENCHMARKS": "ON",
        "CINDER_PGO": "Use",
        "CINDER_PGO_DIR": "${sourceDir}/build/pgo-data"
      }
    },
    {
      "name": "release-clang",
      "inherits": "clang-release-base",
      "displayName": "Release (Clang)",
      "description": "Optimized Clang production release with LTO; benchmarks are opt-in"
    },
    {
      "name": "asan",
      "inherits": "gcc-debug-base",
      "displayName": "ASan+UBSan",
      "description": "Debug build with ASan+UBSan; mimalloc auto-disabled",
      "cacheVariables": {
        "CINDER_LINK_JOBS": "2",
        "CINDER_ENABLE_ASAN": "ON",
        "CINDER_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "asan-clang",
      "inherits": "clang-debug-base",
      "displayName": "ASan+UBSan (Clang)",
      "description": "Clang debug with ASan+UBSan + use-after-scope/return + ignorelist; mimalloc auto-disabled",
      "cacheVariables": {
        "CINDER_LINK_JOBS": "2",
        "CINDER_ENABLE_ASAN": "ON",
        "CINDER_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "msan",
      "inherits": "clang-debug-base",
      "displayName": "MSan (Clang)",
      "description": "Clang with MemorySanitizer — requires an MSan-instrumented C++ standard library to avoid false positives from uninstrumented system libraries; not usable out of the box without that toolchain setup",
      "cacheVariables": {
        "CINDER_LINK_JOBS": "2",
        "CINDER_ENABLE_MSAN": "ON"
      }
    },
    {
      "name": "tsan",
      "inherits": "gcc-debug-base",
      "displayName": "TSan",
      "description": "Debug build with ThreadSanitizer; mimalloc auto-disabled (interceptor conflict)",
      "cacheVariables": {
        "CINDER_LINK_JOBS": "2",
        "CINDER_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "tsan-clang",
      "inherits": "clang-debug-base",
      "displayName": "TSan (Clang)",
      "description": "Clang debug build with ThreadSanitizer; mimalloc auto-disabled (interceptor conflict)",
      "cacheVariables": {
        "CINDER_LINK_JOBS": "2",
        "CINDER_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "ubsan",
      "inherits": "gcc-debug-base",
      "displayName": "UBSan",
      "description": "Debug build with UBSan only",
      "cacheVariables": {
        "CINDER_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "ci",
      "inherits": "base",
      "displayName": "CI (Clang + tidy)",
      "description": "CI build with clang-tidy (Clang, no ASan)",
      "toolchainFile": "${sourceDir}/toolchains/clang22.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CINDER_ENABLE_CLANG_TIDY": "ON",
        "CINDER_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "ci-gcc",
      "inherits": "base",
      "displayName": "CI (GCC + sanitizers)",
      "description": "CI build with GCC, ASan+UBSan; mimalloc auto-disabled",
      "toolchainFile": "${sourceDir}/toolchains/gcc16.cmake",
      "cacheVariables": {
        "CINDER_LINK_JOBS": "2",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CINDER_ENABLE_ASAN": "ON",
        "CINDER_ENABLE_UBSAN": "ON",
        "CINDER_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "tls-grpc",
      "inherits": "gcc-release-base",
      "displayName": "TLS + gRPC",
      "description": "Release build with TLS and gRPC gateway (GCC)",
      "cacheVariables": {
        "CINDER_ENABLE_TLS": "ON",
        "CINDER_ENABLE_GRPC": "ON"
      }
    },
    {
      "name": "tls-grpc-clang",
      "inherits": "clang-release-base",
      "displayName": "TLS + gRPC (Clang)",
      "description": "Release build with TLS and gRPC gateway (Clang)",
      "cacheVariables": {
        "CINDER_ENABLE_TLS": "ON",
        "CINDER_ENABLE_GRPC": "ON"
      }
    },
    {
      "name": "fast",
      "inherits": "gcc-debug-base",
      "displayName": "Fast (unity + lld)",
      "description": "Debug build with unity/jumbo merging and lld (GCC) — fastest edit-compile-test loop, not representative of real performance",
      "cacheVariables": {
        "CINDER_UNITY_BUILD": "ON"
      }
    },
    {
      "name": "release-unity",
      "inherits": "gcc-release-base",
      "displayName": "Release + Unity",
      "description": "Optimized build with unity/jumbo merging — fast rebuilds for perf-iteration work",
      "cacheVariables": {
        "CINDER_UNITY_BUILD": "ON",
        "CINDER_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "profile",
      "inherits": "base",
      "displayName": "Profile",
      "description": "RelWithDebInfo with frame pointers preserved — for perf/flamegraph work",
      "toolchainFile": "${sourceDir}/toolchains/gcc16.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CINDER_KEEP_FRAME_POINTER": "ON",
        "CINDER_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "analyze",
      "inherits": "gcc-debug-base",
      "displayName": "GCC Analyzer",
      "description": "Debug build with GCC's static analyzer (-fanalyzer)",
      "cacheVariables": {
        "CINDER_ENABLE_GCC_ANALYZER": "ON"
      }
    },
    {
      "name": "iwyu",
      "inherits": "clang-debug-base",
      "displayName": "include-what-you-use",
      "description": "Clang build running include-what-you-use during compilation",
      "cacheVariables": {
        "CINDER_ENABLE_IWYU": "ON"
      }
    },
    {
      "name": "fuzz",
      "inherits": "clang-debug-base",
      "displayName": "Fuzz",
      "description": "Debug build with libFuzzer + ASan + UBSan (Clang); mimalloc auto-disabled",
      "cacheVariables": {
        "CINDER_LINK_JOBS": "2",
        "CINDER_ENABLE_FUZZER": "ON",
        "CINDER_ENABLE_ASAN": "ON",
        "CINDER_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "fuzz-coverage",
      "inherits": "clang-debug-base",
      "displayName": "Fuzz + Coverage",
      "description": "Clang build with coverage instrumentation for corpus minimization",
      "cacheVariables": {
        "CINDER_LINK_JOBS": "2",
        "CINDER_ENABLE_COVERAGE": "ON",
        "CINDER_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "debug-grpc",
      "inherits": "gcc-debug-base",
      "displayName": "Debug + gRPC",
      "description": "Debug build with gRPC gateway enabled (fetches gRPC + protobuf + abseil)",
      "cacheVariables": {
        "CINDER_ENABLE_GRPC": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug",          "configurePreset": "debug" },
    { "name": "debug-tls",      "configurePreset": "debug-tls" },
    { "name": "debug-tls-clang", "configurePreset": "debug-tls-clang" },
    { "name": "debug-clang",    "configurePreset": "debug-clang" },
    { "name": "release",        "configurePreset": "release" },
    { "name": "release-bench",  "configurePreset": "release-bench" },
    { "name": "release-clang",  "configurePreset": "release-clang" },
    { "name": "pgo-generate",   "configurePreset": "pgo-generate" },
    { "name": "pgo-use",        "configurePreset": "pgo-use" },
    { "name": "asan",           "configurePreset": "asan" },
    { "name": "asan-clang",     "configurePreset": "asan-clang" },
    { "name": "msan",           "configurePreset": "msan" },
    { "name": "tsan",           "configurePreset": "tsan" },
    { "name": "tsan-clang",     "configurePreset": "tsan-clang" },
    { "name": "ubsan",          "configurePreset": "ubsan" },
    { "name": "ci",             "configurePreset": "ci" },
    { "name": "ci-gcc",         "configurePreset": "ci-gcc" },
    { "name": "tls-grpc",       "configurePreset": "tls-grpc" },
    { "name": "tls-grpc-clang", "configurePreset": "tls-grpc-clang" },
    { "name": "fast",           "configurePreset": "fast" },
    { "name": "release-unity",  "configurePreset": "release-unity" },
    { "name": "profile",        "configurePreset": "profile" },
    { "name": "analyze",        "configurePreset": "analyze" },
    { "name": "iwyu",           "configurePreset": "iwyu" },
    { "name": "fuzz",           "configurePreset": "fuzz" },
    { "name": "fuzz-coverage",  "configurePreset": "fuzz-coverage" },
    { "name": "debug-grpc",     "configurePreset": "debug-grpc" }
  ],
  "testPresets": [
    {
      "name": "test-common",
      "hidden": true,
      "output": { "outputOnFailure": true }
    },
    { "name": "debug",          "configurePreset": "debug",          "inherits": "test-common" },
    { "name": "debug-tls",      "configurePreset": "debug-tls",      "inherits": "test-common" },
    { "name": "debug-clang",    "configurePreset": "debug-clang",    "inherits": "test-common" },
    { "name": "release",        "configurePreset": "release",        "inherits": "test-common" },
    { "name": "release-clang",  "configurePreset": "release-clang",  "inherits": "test-common" },
    {
      "name": "test-asan",
      "hidden": true,
      "inherits": "test-common",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1:check_initialization_order=1:strict_init_order=1:suppressions=${sourceDir}/suppressions/asan.supp",
        "LSAN_OPTIONS": "suppressions=${sourceDir}/suppressions/lsan.supp"
      }
    },
    {
      "name": "test-tsan",
      "hidden": true,
      "inherits": "test-common",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1:history_size=7:suppressions=${sourceDir}/suppressions/tsan.supp"
      }
    },
    { "name": "asan",           "configurePreset": "asan",           "inherits": "test-asan" },
    { "name": "asan-clang",     "configurePreset": "asan-clang",     "inherits": "test-asan" },
    { "name": "tsan",           "configurePreset": "tsan",           "inherits": "test-tsan" },
    { "name": "tsan-clang",     "configurePreset": "tsan-clang",     "inherits": "test-tsan" },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "inherits": "test-common",
      "environment": {
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1:suppressions=${sourceDir}/suppressions/ubsan.supp"
      }
    },
    { "name": "msan",           "configurePreset": "msan",           "inherits": "test-common" },
    { "name": "fast",           "configurePreset": "fast",           "inherits": "test-common" },
    { "name": "release-unity",  "configurePreset": "release-unity",  "inherits": "test-common" },
    { "name": "profile",        "configurePreset": "profile",        "inherits": "test-common" },
    { "name": "ci",             "configurePreset": "ci",             "inherits": "test-common" },
    { "name": "ci-gcc",         "configurePreset": "ci-gcc",         "inherits": "test-common" },
    { "name": "tls-grpc",       "configurePreset": "tls-grpc",       "inherits": "test-common" },
    { "name": "tls-grpc-clang", "configurePreset": "tls-grpc-clang", "inherits": "test-common" },
    { "name": "debug-tls-clang", "configurePreset": "debug-tls-clang", "inherits": "test-common" },
    { "name": "fuzz",           "configurePreset": "fuzz",           "inherits": "test-common" },
    { "name": "debug-grpc",     "configurePreset": "debug-grpc",     "inherits": "test-common" }
  ]
}
