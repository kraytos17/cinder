{
   "version":6,
   "configurePresets":[
      {
         "name":"debug",
         "displayName":"Debug",
         "description":"Debug build with Ninja (GCC)",
         "generator":"Ninja",
         "binaryDir":"${sourceDir}/build/debug",
         "cacheVariables":{
            "CMAKE_BUILD_TYPE":"Debug"
         }
      },
      {
         "name":"debug-tls",
         "displayName":"Debug + TLS",
         "description":"Debug build with TLS/SSL enabled",
         "generator":"Ninja",
         "binaryDir":"${sourceDir}/build/debug-tls",
         "cacheVariables":{
            "CMAKE_BUILD_TYPE":"Debug",
            "CINDER_ENABLE_TLS":"ON"
         }
      },
      {
         "name":"debug-clang",
         "displayName":"Debug (Clang)",
         "description":"Debug build with Ninja and Clang",
         "generator":"Ninja",
         "binaryDir":"${sourceDir}/build/debug-clang",
         "cacheVariables":{
            "CMAKE_BUILD_TYPE":"Debug",
            "CMAKE_CXX_COMPILER":"clang++",
            "CMAKE_C_COMPILER":"clang"
         }
      },
      {
         "name":"release",
         "displayName":"Release",
         "description":"Optimized release build with LTO (GCC)",
         "generator":"Ninja",
         "binaryDir":"${sourceDir}/build/release",
         "cacheVariables":{
            "CMAKE_BUILD_TYPE":"Release",
            "CINDER_ENABLE_LTO":"ON"
         }
      },
      {
         "name":"release-clang",
         "displayName":"Release (Clang)",
         "description":"Optimized release build with LTO (Clang)",
         "generator":"Ninja",
         "binaryDir":"${sourceDir}/build/release-clang",
         "cacheVariables":{
            "CMAKE_BUILD_TYPE":"Release",
            "CMAKE_CXX_COMPILER":"clang++",
            "CMAKE_C_COMPILER":"clang",
            "CINDER_ENABLE_LTO":"ON"
         }
      },
      {
         "name":"sanitized",
         "displayName":"Sanitized",
         "description":"Debug build with ASan+UBSan (GCC); mimalloc auto-disabled",
         "generator":"Ninja",
         "binaryDir":"${sourceDir}/build/sanitized",
         "cacheVariables":{
            "CMAKE_BUILD_TYPE":"Debug",
            "CINDER_ENABLE_ASAN":"ON",
            "CINDER_ENABLE_UBSAN":"ON"
         }
      },
      {
         "name":"asan",
         "displayName":"ASan+UBSan",
         "description":"Debug build with ASan+UBSan; mimalloc auto-disabled",
         "generator":"Ninja",
         "binaryDir":"${sourceDir}/build/asan",
         "cacheVariables":{
            "CMAKE_BUILD_TYPE":"Debug",
            "CINDER_ENABLE_ASAN":"ON",
            "CINDER_ENABLE_UBSAN":"ON"
         }
      },
      {
         "name":"asan-clang",
         "displayName":"ASan+UBSan (Clang)",
         "description":"Clang debug with ASan+UBSan + use-after-scope/return + ignorelist; mimalloc auto-disabled",
         "generator":"Ninja",
         "binaryDir":"${sourceDir}/build/asan-clang",
         "cacheVariables":{
            "CMAKE_BUILD_TYPE":"Debug",
            "CMAKE_CXX_COMPILER":"clang++",
            "CMAKE_C_COMPILER":"clang",
            "CINDER_ENABLE_ASAN":"ON",
            "CINDER_ENABLE_UBSAN":"ON"
         }
      },
      {
         "name":"msan",
         "displayName":"MSan (Clang)",
         "description":"Clang with MemorySanitizer (experimental, needs instrumented libc++); mimalloc auto-disabled",
         "generator":"Ninja",
         "binaryDir":"${sourceDir}/build/msan",
         "cacheVariables":{
            "CMAKE_BUILD_TYPE":"Debug",
            "CMAKE_CXX_COMPILER":"clang++",
            "CMAKE_C_COMPILER":"clang",
            "CINDER_ENABLE_MSAN":"ON"
         }
      },
      {
         "name":"tsan",
         "displayName":"TSan",
         "description":"Debug build with ThreadSanitizer; mimalloc auto-disabled (interceptor conflict)",
         "generator":"Ninja",
         "binaryDir":"${sourceDir}/build/tsan",
         "cacheVariables":{
            "CMAKE_BUILD_TYPE":"Debug",
            "CINDER_ENABLE_TSAN":"ON"
         }
      },
      {
         "name":"ubsan",
         "displayName":"UBSan",
         "description":"Debug build with UBSan only",
         "generator":"Ninja",
         "binaryDir":"${sourceDir}/build/ubsan",
         "cacheVariables":{
            "CMAKE_BUILD_TYPE":"Debug",
            "CINDER_ENABLE_UBSAN":"ON"
         }
      },
      {
         "name":"ci",
         "displayName":"CI (Clang + tidy)",
         "description":"CI build with clang-tidy (Clang, no ASan)",
         "generator":"Ninja",
         "binaryDir":"${sourceDir}/build/ci",
         "cacheVariables":{
            "CMAKE_BUILD_TYPE":"RelWithDebInfo",
            "CMAKE_CXX_COMPILER":"clang++",
            "CMAKE_C_COMPILER":"clang",
            "CINDER_ENABLE_CLANG_TIDY":"ON"
         }
      },
      {
         "name":"ci-gcc",
         "displayName":"CI (GCC + sanitizers)",
         "description":"CI build with GCC, ASan+UBSan; mimalloc auto-disabled",
         "generator":"Ninja",
         "binaryDir":"${sourceDir}/build/ci-gcc",
         "cacheVariables":{
            "CMAKE_BUILD_TYPE":"RelWithDebInfo",
            "CINDER_ENABLE_ASAN":"ON",
            "CINDER_ENABLE_UBSAN":"ON"
         }
      },
      {
         "name":"fast",
         "displayName":"Fast (unity + lld)",
         "description":"Debug build with unity/jumbo merging and lld (GCC)",
         "generator":"Ninja",
         "binaryDir":"${sourceDir}/build/fast",
         "cacheVariables":{
            "CMAKE_BUILD_TYPE":"Debug",
            "CINDER_UNITY_BUILD":"ON"
         }
      },
      {
         "name":"fuzz",
         "displayName":"Fuzz",
         "description":"Debug build with libFuzzer + ASan + UBSan (Clang); mimalloc auto-disabled",
         "generator":"Ninja",
         "binaryDir":"${sourceDir}/build/fuzz",
         "cacheVariables":{
            "CMAKE_BUILD_TYPE":"Debug",
            "CMAKE_CXX_COMPILER":"clang++",
            "CMAKE_C_COMPILER":"clang",
            "CINDER_ENABLE_FUZZER":"ON",
            "CINDER_ENABLE_ASAN":"ON",
            "CINDER_ENABLE_UBSAN":"ON"
         }
      },
      {
         "name":"fuzz-coverage",
         "displayName":"Fuzz + Coverage",
         "description":"Clang build with coverage instrumentation for corpus minimization",
         "generator":"Ninja",
         "binaryDir":"${sourceDir}/build/fuzz-coverage",
         "cacheVariables":{
            "CMAKE_BUILD_TYPE":"Debug",
            "CMAKE_CXX_COMPILER":"clang++",
            "CMAKE_C_COMPILER":"clang",
            "CINDER_ENABLE_COVERAGE":"ON",
            "CINDER_ENABLE_ASAN":"ON"
         }
      }
   ],
   "buildPresets":[
      {
         "name":"debug",
         "configurePreset":"debug"
      },
      {
         "name":"debug-tls",
         "configurePreset":"debug-tls"
      },
      {
         "name":"debug-clang",
         "configurePreset":"debug-clang"
      },
      {
         "name":"release",
         "configurePreset":"release"
      },
      {
         "name":"release-clang",
         "configurePreset":"release-clang"
      },
      {
         "name":"sanitized",
         "configurePreset":"sanitized"
      },
      {
         "name":"asan",
         "configurePreset":"asan"
      },
      {
         "name":"asan-clang",
         "configurePreset":"asan-clang"
      },
      {
         "name":"msan",
         "configurePreset":"msan"
      },
      {
         "name":"tsan",
         "configurePreset":"tsan"
      },
      {
         "name":"ubsan",
         "configurePreset":"ubsan"
      },
      {
         "name":"ci",
         "configurePreset":"ci"
      },
      {
         "name":"ci-gcc",
         "configurePreset":"ci-gcc"
      },
      {
         "name":"fast",
         "configurePreset":"fast"
      },
      {
         "name":"fuzz",
         "configurePreset":"fuzz"
      },
      {
         "name":"fuzz-coverage",
         "configurePreset":"fuzz-coverage"
      }
   ],
   "testPresets":[
      {
         "name":"debug",
         "configurePreset":"debug",
         "output":{ "outputOnFailure":true }
      },
      {
         "name":"debug-tls",
         "configurePreset":"debug-tls",
         "output":{ "outputOnFailure":true }
      },
      {
         "name":"debug-clang",
         "configurePreset":"debug-clang",
         "output":{ "outputOnFailure":true }
      },
      {
         "name":"release",
         "configurePreset":"release",
         "output":{ "outputOnFailure":true }
      },
      {
         "name":"release-clang",
         "configurePreset":"release-clang",
         "output":{ "outputOnFailure":true }
      },
      {
         "name":"sanitized",
         "configurePreset":"sanitized",
         "output":{ "outputOnFailure":true },
         "environment":{
            "ASAN_OPTIONS":"detect_leaks=1:abort_on_error=1:check_initialization_order=1:strict_init_order=1:suppressions=${sourceDir}/suppressions/asan.supp",
            "LSAN_OPTIONS":"suppressions=${sourceDir}/suppressions/lsan.supp"
         }
      },
      {
         "name":"asan",
         "configurePreset":"asan",
         "output":{ "outputOnFailure":true },
         "environment":{
            "ASAN_OPTIONS":"detect_leaks=1:abort_on_error=1:check_initialization_order=1:strict_init_order=1:suppressions=${sourceDir}/suppressions/asan.supp",
            "LSAN_OPTIONS":"suppressions=${sourceDir}/suppressions/lsan.supp"
         }
      },
      {
         "name":"asan-clang",
         "configurePreset":"asan-clang",
         "output":{ "outputOnFailure":true },
         "environment":{
            "ASAN_OPTIONS":"detect_leaks=1:abort_on_error=1:check_initialization_order=1:strict_init_order=1:suppressions=${sourceDir}/suppressions/asan.supp",
            "LSAN_OPTIONS":"suppressions=${sourceDir}/suppressions/lsan.supp"
         }
      },
      {
         "name":"tsan",
         "configurePreset":"tsan",
         "output":{ "outputOnFailure":true },
         "environment":{
            "TSAN_OPTIONS":"halt_on_error=1:second_deadlock_stack=1:history_size=7:suppressions=${sourceDir}/suppressions/tsan.supp"
         }
      },
      {
         "name":"ubsan",
         "configurePreset":"ubsan",
         "output":{ "outputOnFailure":true },
         "environment":{
            "UBSAN_OPTIONS":"halt_on_error=1:print_stacktrace=1:suppressions=${sourceDir}/suppressions/ubsan.supp"
         }
      },
      {
         "name":"msan",
         "configurePreset":"msan",
         "output":{ "outputOnFailure":true }
      },
      {
         "name":"fast",
         "configurePreset":"fast",
         "output":{ "outputOnFailure":true }
      },
      {
         "name":"ci",
         "configurePreset":"ci",
         "output":{ "outputOnFailure":true }
      },
      {
         "name":"ci-gcc",
         "configurePreset":"ci-gcc",
         "output":{ "outputOnFailure":true }
      },
      {
         "name":"fuzz",
         "configurePreset":"fuzz",
         "output":{ "outputOnFailure":true }
      }
   ],
   "workflowPresets":[
      {
         "name":"ci",
         "steps":[
            { "type":"configure", "name":"ci" },
            { "type":"build",     "name":"ci" },
            { "type":"test",      "name":"ci" }
         ]
      },
      {
         "name":"ci-gcc",
         "steps":[
            { "type":"configure", "name":"ci-gcc" },
            { "type":"build",     "name":"ci-gcc" },
            { "type":"test",      "name":"ci-gcc" }
         ]
      }
   ]
}
