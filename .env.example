# Cinder developer overrides. Copy to `.env` (git-ignored) and uncomment what
# you need — `just` loads it automatically (see `set dotenv-load` in Justfile).
# Command-line `VAR=value` and exported environment variables take precedence.
#
# Which preset family to use:
# CINDER_PRESET=debug
# CINDER_BENCH_PRESET=release
#
# Parallelism:
# CINDER_JOBS=8                 # fallback for test workers and other recipes
# CINDER_BUILD_JOBS=4           # CMake build jobs (default 4, memory-safe)
# CINDER_TEST_JOBS=8            # unit/sim/cli ctest jobs (default CINDER_JOBS)
# CINDER_INTEGRATION_JOBS=8     # defaults to CINDER_TEST_JOBS
#
# Replication benchmark selection for bench-repl / samply-repl / perf-stat-repl:
# CINDER_REPL_FILTER=Quorum|ReplayBatch
#
# Benchmark workload sizes:
# CINDER_BENCH_REPETITIONS=11
# CINDER_BENCH_MIN_TIME=0.05
# CINDER_SAMPLY_MIN_TIME=0.5
# CINDER_PERF_REPETITIONS=3
# CINDER_PERF_MIN_TIME=2
#
# perf-stat-repl only:
# CINDER_PERF_CPU=2
# CINDER_SAMPLY_OUTPUT=build/release/repl_profile.json.gz
#
# PGO training:
# CINDER_PGO_TRAIN_MIN_TIME=0.1
#
# Shared dependency source cache (default: ~/.cache/cinder/deps):
# CINDER_DEPS_CACHE=/path/to/deps
#
# Pre-fetch dependencies without configuring (uses FetchDeps.cmake):
# CINDER_DEPS_WITH_GRPC=ON      # also fetch gRPC + protobuf + abseil
# CINDER_PRINT_DIR=ON           # print the resolved deps cache dir and exit
#
# Configure-time toggles (also passable as -D flags):
# CINDER_AUTO_HOOKS=OFF         # don't auto-install the git pre-commit hook
# CINDER_BUILD_BENCHMARKS=ON    # build benchmark targets (default ON only for release/profile presets)
